<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="84dp">
    <LinearLayout
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/btnLibrary" style="@style/TopButton"
            android:text="@string/app_library"
            android:drawableStart="@drawable/ic_apps" />
        <TextView android:id="@+id/btnSaver" style="@style/TopButton"
            android:layout_marginStart="16dp"
            android:text="Screensaver"
            android:drawableStart="@drawable/ic_screensaver" />
    </LinearLayout>
</FrameLayout>
